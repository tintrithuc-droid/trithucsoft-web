# Kết nối PostgreSQL
DATABASE_URL=postgres://trithuc:doi-mat-khau@localhost:5432/trithuc
# Chuỗi bí mật cho phiên đăng nhập: đặt chuỗi ngẫu nhiên dài (ví dụ: openssl rand -hex 32)
SESSION_SECRET=
# Địa chỉ chính thức của website (dùng cho sitemap, canonical, ảnh chia sẻ)
BASE_URL=https://trithucsoft.vn
PORT=3000
# Chỉ nghe nội bộ khi có Caddy/IIS phía trước (để trống: nghe mọi địa chỉ)
HOST=
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh
# Tài khoản quản trị tạo ở lần chạy đầu tiên (đổi mật khẩu ngay sau khi đăng nhập)
ADMIN_EMAIL=admin@trithucsoft.vn
ADMIN_PASSWORD=
# Đặt 0 nếu chạy thử bằng http (chưa có HTTPS)
COOKIE_SECURE=1
# Email báo yêu cầu tư vấn mới (không bắt buộc)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
