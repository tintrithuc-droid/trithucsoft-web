<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cổng vào IIS cho website Tri Thức mới (Node.js, dịch vụ TriThucWeb, 127.0.0.1:3000).
  Thư mục này chỉ chứa web.config; mọi yêu cầu được chuyển tiếp qua ARR về Node.
  inheritInChildApplications="false": các app con cũ (/be, /be/FileUploader, /FileUploader...)
  của site trithucsoft.vn vẫn chạy như trước, không bị chuyển về Node.
  Biến HTTP_X_FORWARDED_PROTO/HOST được cho phép ở applicationHost.config (location trithucsoft.vn).
  Tạo ngày 18/11/2026.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!-- Ép dùng HTTPS -->
          <rule name="Chuyen sang HTTPS" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTPS}" pattern="off" />
              <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
          </rule>
          <!-- www.trithucsoft.vn về trithucsoft.vn -->
          <rule name="Bo www" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTP_HOST}" pattern="^www\.(.+)$" />
            </conditions>
            <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
          </rule>
          <!-- Đường dẫn của website cũ (giữ thứ hạng tìm kiếm) -->
          <rule name="Cu - giai phap" stopProcessing="true">
            <match url="^giai-phap-phan-mem(/.*)?$" />
            <action type="Redirect" url="/giai-phap{R:1}" redirectType="Permanent" />
          </rule>
          <rule name="Cu - du an" stopProcessing="true">
            <match url="^du-an-tieu-bieu(/.*)?$" />
            <action type="Redirect" url="/du-an{R:1}" redirectType="Permanent" />
          </rule>
          <rule name="Cu - tu van" stopProcessing="true">
            <match url="^tu-van-cntt/.+$" />
            <action type="Redirect" url="/tu-van-cntt" redirectType="Permanent" />
          </rule>
          <rule name="Cu - ban quyen" stopProcessing="true">
            <match url="^phan-mem-ban-quyen/.+$" />
            <action type="Redirect" url="/phan-mem-ban-quyen" redirectType="Permanent" />
          </rule>
          <!-- Tin bài website cũ: slug cũ -> slug mới -->
          <rule name="Cu - tin tuc" stopProcessing="true">
            <match url="^tin-tuc/([^/]+)/?$" />
            <conditions>
              <add input="{TinCu:{R:1}}" pattern="(.+)" />
            </conditions>
            <action type="Redirect" url="/tin-tuc/{C:1}" redirectType="Permanent" />
          </rule>
          <rule name="Cu - privacy" stopProcessing="true">
            <match url="^privacy-policy/?$" />
            <action type="Redirect" url="/chinh-sach-bao-mat" redirectType="Permanent" />
          </rule>
          <rule name="Cu - terms" stopProcessing="true">
            <match url="^terms-of-service/?$" />
            <action type="Redirect" url="/dieu-khoan-su-dung" redirectType="Permanent" />
          </rule>
          <!-- Service worker tự hủy (gỡ service worker của website cũ khỏi trình duyệt khách), IIS phục vụ trực tiếp -->
          <rule name="SW tu huy" stopProcessing="true">
            <match url="^proxy-service-worker\.js$" />
            <action type="None" />
          </rule>
          <!-- Mọi yêu cầu còn lại chuyển về Node.js -->
          <rule name="Chuyen ve Node" stopProcessing="true">
            <match url="(.*)" />
            <serverVariables>
              <set name="HTTP_X_FORWARDED_PROTO" value="https" />
              <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            </serverVariables>
            <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          </rule>
        </rules>
      <rewriteMaps>
        <rewriteMap name="TinCu">
          <add key="nang-cap-cong-thong-tin" value="nang-cap-cong-thong-tin-dien-tu-tinh-uy-vinh-long" />
          <add key="phuong-vi-thanh-ra-mat" value="phuong-vi-thanh-ra-mat-ban-do-so-gis-phuc-vu-cong-tac-bau-cu" />
          <add key="he-thong-ban-do-so" value="he-thong-ban-do-so-phuc-vu-dac-luc-cho-cong-tac-tuyen-truyen-bau-cu" />
          <add key="trien-khai-ban-do-so" value="trien-khai-ban-do-so-phuc-vu-cong-tac-tuyen-truyen-bau-cu-dai-bieu-quoc" />
          <add key="trien-khai-thanh-cong-phan" value="trien-khai-thanh-cong-phan-mem-co-so-du-lieu-nganh-cong-thuong-tinh-ca" />
          <add key="tri-thuc-–-20-nam" value="tri-thuc-20-nam-mot-hanh-trinh-van-loi-tri-an" />
          <add key="tri-thuc-trien-khai-thanh" value="tri-thuc-trien-khai-thanh-cong-he-thong-quan-ly-giao-thong-van-tai-ben" />
          <add key="tu-van-va-trien-khai" value="tu-van-va-trien-khai-chuyen-doi-so-toan-dien-cho-ban-nong-nghiep-ung" />
          <add key="trien-khai-he-thong-phan" value="trien-khai-he-thong-phan-mem-quan-ly-ho-kinh-doanh-cho-nhieu-tinh-thanh" />
          <add key="viec-ton-trong-ban-quyen" value="viec-ton-trong-ban-quyen-la-dieu-kien-can-de-xay-dung-nen-kinh-te-dua" />
          <add key="tri-thuc-–-dong-hanh" value="tri-thuc-dong-hanh-tu-van-chuyen-doi-so-toan-dien-cho-cac-du-an-cong" />
          <add key="kham-xet-khan-cap-5" value="kham-xet-khan-cap-5-dia-diem-3-cong-ty-trong-vu-an-xam-pham-ban-quyen" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>
      <!-- Ảnh, PDF tải lên tối đa 15 MB -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="20971520" />
        </requestFiltering>
      </security>
      <!-- Không cache tệp trong thư mục này (service worker tự hủy) -->
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <!-- Để trang lỗi của website hiện nguyên, không bị IIS thay -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
