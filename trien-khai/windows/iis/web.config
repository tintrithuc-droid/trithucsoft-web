<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dùng IIS làm cổng vào cho website Tri Thức (khi máy chủ đã có IIS chiếm cổng 80/443).
  Cần cài thêm 2 mô-đun miễn phí của Microsoft: URL Rewrite và Application Request Routing (ARR),
  rồi bật Proxy trong ARR. Xem mục "Dùng IIS" trong HUONG-DAN.md.

  Chép tệp này vào thư mục gốc của site IIS (ví dụ C:\inetpub\trithucsoft).
  Nếu website chạy cổng khác 3000, sửa 127.0.0.1:3000 bên dưới.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
      </allowedServerVariables>
      <rules>
        <!-- Ép dùng HTTPS -->
        <rule name="Chuyen sang HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- www.trithucsoft.vn về trithucsoft.vn -->
        <rule name="Bo www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" />
          </conditions>
          <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Mọi yêu cầu chuyển về Node.js -->
        <rule name="Chuyen ve Node" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Ảnh, PDF tải lên tối đa 15 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
    <!-- Để trang lỗi của website hiện nguyên, không bị IIS thay -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
