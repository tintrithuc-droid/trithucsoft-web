<%- include('_top', { title: 'Đổi mật khẩu' }) %>
<form method="post" class="panel form" style="max-width:520px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
  <div class="f"><label for="c">Mật khẩu hiện tại</label><input id="c" type="password" name="current" autocomplete="current-password" required></div>
  <div class="f"><label for="n">Mật khẩu mới (tối thiểu 10 ký tự)</label><input id="n" type="password" name="next" autocomplete="new-password" required minlength="10"></div>
  <div class="f"><label for="r">Nhập lại mật khẩu mới</label><input id="r" type="password" name="confirm" autocomplete="new-password" required minlength="10"></div>
  <div class="actions"><button class="btn primary">Đổi mật khẩu</button></div>
</form>
<%- include('_bottom') %>
